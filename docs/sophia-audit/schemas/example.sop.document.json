    { "type": "heading", "id": "b-scope00001", "level": 1, "text": "Alcance" },
    {
      "type": "paragraph",
      "id": "b-scope00002",
      "content": [
        { "text": "Describe cómo recibir una solicitud de información de materia prima, adjuntar los certificados y enviarla a revisión." }
      ]
    },
    { "type": "heading", "id": "b-gener00001", "level": 1, "text": "Consideraciones generales" },
    {
      "type": "list",
      "id": "b-gener00002",
      "ordered": false,
      "items": [
        { "id": "b-gener00003", "content": [ { "text": "Usa siempre las plantillas actualizadas enlazadas en la solicitud." } ] },
        {
          "id": "b-gener00004",
          "content": [
            { "text": "La divulgación de fórmula contiene datos confidenciales. Alcance exacto de visibilidad: " },
            { "text": "TO BE CONFIRMED", "marks": ["tbc"] },
            { "text": "." }
          ]
        }
      ]
    },
    { "type": "heading", "id": "b-proce00001", "level": 1, "text": "Procedimiento" },
    { "type": "heading", "id": "b-proce00002", "level": 2, "text": "Recibir y abrir la solicitud" },
    {
      "type": "step",
      "id": "b-step000001",
      "role": "Proveedor",
      "content": [ { "text": "Abre el correo de notificación e identifica el enlace de acceso." } ]
    },
    {
      "type": "step",
      "id": "b-step000002",
      "role": "Proveedor",
      "content": [
        { "text": "Inicia sesión en el portal y vuelve a pulsar el enlace de la solicitud si no se abre directamente." }
      ],
      "expected": [ { "text": "La pestaña de información prellenada aparece en solo lectura." } ]
    },
    {
      "type": "callout",
      "id": "b-confi00001",
      "variant": "confirmation",
      "title": "Confirmación requerida",
      "content": [
        { "text": "La fuente no explica qué acción tomar cuando la información inicial es correcta. No inferir una acción a partir de este borrador." }
      ]
    },
    { "type": "heading", "id": "b-proce00003", "level": 2, "text": "Seleccionar la acción de envío" },
